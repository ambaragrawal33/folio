# Buildable release artifacts. Public production startup remains gated by O02/O04/O06.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS build
WORKDIR /workspace
ENV HUSKY=0
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile
RUN pnpm tokens:check && pnpm --filter @folio/shared build && pnpm --filter @folio/api build && pnpm --filter @folio/web build

# Retain reviewed workspace links and frozen versions; legacy deploy leaves external links on pnpm 11.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS production-dependencies
WORKDIR /workspace
ENV HUSKY=0
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json
# Native argon2 ships a platform prebuild; runtime import is verified in the artifact smoke.
# Ignore lifecycle scripts here: root Husky is intentionally absent from production dependencies.
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

FROM scratch AS web-artifact
COPY --from=build /workspace/apps/web/dist /

FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS api-runtime
WORKDIR /workspace/apps/api
COPY --from=production-dependencies --chown=node:node /workspace /workspace
COPY --from=build --chown=node:node /workspace/apps/api/dist ./dist
COPY --from=build --chown=node:node /workspace/packages/shared/dist /workspace/packages/shared/dist
USER node
ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:'+ (process.env.PORT || '3000') +'/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
