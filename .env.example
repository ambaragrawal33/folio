# Development only. Copy to .env for host-process development; never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/folio?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
EMAIL_TRANSPORT=mailhog
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# API_PROXY_TARGET is used by the Vite server only. No server secrets use VITE_*.
API_PROXY_TARGET=http://127.0.0.1:3000
# Authentication/provider/encryption secrets are introduced in their authorized phases.
