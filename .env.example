# Development only. Copy to .env for host-process development; never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/folio?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
EMAIL_TRANSPORT=mailhog
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# API_PROXY_TARGET is used by the Vite server only. No server secrets use VITE_*.
API_PROXY_TARGET=http://127.0.0.1:3000
# Local auth keys are generated by `node scripts/init-local-env.mjs` into ignored .env.
# Never copy credentials into VITE_* variables.
DEMO_MODE=false
CACHE_NAMESPACE=folio:normal
# Opt in only via docker-compose.fixture.yml or the isolated host setup in docs/LOCAL_FIXTURE_MODE.md.
# Never turn this on with the normal/demo Mongo database or Redis DB 0.
LOCAL_FIXTURE_MODE=false
# Optional CoinGecko Demo key: configure only in ignored server env/secret storage.
# COINGECKO_DEMO_KEY=
# Yahoo rights are unverified. Enable only after verifying actual display entitlement.
YAHOO_DISPLAY_ENTITLED=false
# YAHOO_ENTITLEMENT_REFERENCE=
# Local jobs are opt-in. Compose jobs override enables workers; scheduling stays off.
LOCAL_JOBS_ENABLED=false
LOCAL_JOB_SCHEDULES=false
JOB_RUNNER_MODE=bullmq
# JOB_HTTP_SECRET= (generate locally; minimum 32 characters, never VITE_*)
# Display entitlement does not grant durable observation/close retention rights.
YAHOO_OBSERVATION_ENTITLED=false
YAHOO_CLOSE_CAPTURE_ENTITLED=false
COINGECKO_OBSERVATION_ENTITLED=false
# OBSERVATION_RIGHTS_REFERENCE= (only after actual rights verification)
