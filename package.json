{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "type": "module",
  "scripts": {
    "tokens:sync": "node packages/design-tokens/scripts/sync.mjs",
    "tokens:check": "node packages/design-tokens/scripts/sync.mjs --check",
    "build": "pnpm tokens:check && pnpm --filter @folio/shared build && pnpm --filter @folio/api build && pnpm --filter @folio/web build",
    "dev": "pnpm --filter @folio/shared build && pnpm --parallel --filter @folio/api --filter @folio/web dev",
    "lint": "eslint . && pnpm tokens:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @folio/shared build && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/coverage-financial.mjs",
    "test:e2e": "playwright test",
    "deps:verify": "node scripts/verify-dependencies.mjs",
    "prepare": "husky",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.0",
    "prettier": "3.9.9",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "jsdom": "30.1.1",
    "semver": "7.8.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,md,html}": "prettier --write"
  }
}
